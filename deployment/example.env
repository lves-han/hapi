HAPI_HOME=/data/hapi
HAPI_UID=1000
HAPI_GID=1000
# Set DB_PATH when the original deployment used a custom path.
DB_PATH=
HAPI_POSTGRES_DATA_DIR=/data/hapi-postgres
POSTGRES_ADMIN_PASSWORD=replace_with_an_independent_random_hex_secret
HAPI_DATABASE_PASSWORD=replace_with_a_random_hex_secret
DATABASE_URL=postgresql://hapi:replace_with_a_random_hex_secret@postgres:5432/hapi
HAPI_BIND_ADDRESS=127.0.0.1
HAPI_PORT=3006
HAPI_PUBLIC_URL=https://hapi.example.com
